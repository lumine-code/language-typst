{
  "name": "Typst",
  "scopeName": "source.typst",
  "type": "tree-sitter",
  "parser": "tree-sitter-typst",
  "injectionNames": ["typst"],
  "firstLineRegex": ["#set\\s", "#import\\s"],
  "fileTypes": ["typ"],
  "comments": {
    "start": "// ",
    "line": "//",
    "block": ["/*", "*/"]
  },
  "treeSitter": {
    "parserSource": "github:uben0/tree-sitter-typst#46cf4ded12ee974a70bf8457263b67ad7ee0379d",
    "wasmBuildTool": "tree-sitter-cli#v0.27.0",
    "grammar": "typst.wasm",
    "highlightsQuery": "typst-highlights.scm",
    "foldsQuery": "typst-folds.scm",
    "indentsQuery": "typst-indents.scm",
    "tagsQuery": "typst-tags.scm"
  }
}
